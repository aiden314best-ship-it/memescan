# Copy to .env.local and adjust. Every variable is optional; the app runs with none set.

# Solana JSON-RPC endpoint used by the SERVER (never sent to the browser).
# Default: https://api.mainnet-beta.solana.com (free, heavily rate-limited, some methods
# such as getTokenLargestAccounts may be throttled). For better reliability use a free-tier
# key from an RPC provider and paste its full URL here. It stays server-side.
SOLANA_RPC_URL=

# Max RPC requests per minute this server will make (default 90).
RPC_REQUESTS_PER_MINUTE=

# Optional Jupiter Developer Platform API key (free tier, no payment, sign-up at
# https://developers.jup.ag/portal). Without it, requests are "keyless" at 0.5 req/s.
# Server-side only: it is sent in the x-api-key header from API routes, never to the browser.
JUPITER_API_KEY=

# Real-money swap execution. OFF unless set to exactly "true". Read the README section
# "Enabling swaps" first. This value is public (inlined into the browser bundle) and must
# be set at BUILD time (rebuild after changing it).
NEXT_PUBLIC_ENABLE_SWAP_EXECUTION=false
